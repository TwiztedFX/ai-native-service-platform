PORT=8787
DATABASE_DIR=./data
SESSION_TTL_HOURS=168
COOKIE_SECURE=0

# Optional narrative enrichment. The summary is stored as text and cannot change price or permissions.
# Copy this file to .env. The server reads .env on startup and does not override variables already set.
# Grok 4.7 is a Cursor model id. A key that starts with crsr_, or a base URL on api.cursor.com,
# is not sent to api.openai.com. Leave AI_MODEL empty to use grok-4.7 for that Cursor path.
# For any other key, set AI_BASE_URL to an OpenAI-compatible chat endpoint and AI_MODEL to a model id it accepts.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
