PORT=8787
DATABASE_DIR=./data
SESSION_TTL_HOURS=168
COOKIE_SECURE=0

# Optional narrative enrichment. Pricing, permissions, and delivery never depend on this.
# Copy this file to .env. The server reads .env on startup and does not override variables already set.
# Use an OpenAI-compatible chat endpoint. Set AI_MODEL to a model id that provider accepts.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional Stripe Checkout. Both values must be set or checkout and the webhook return 409.
# Leave them empty to keep projects at accepted_unbilled. Do not commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
